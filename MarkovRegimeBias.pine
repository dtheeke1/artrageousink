//@version=6
indicator("Markov Regime Bias  v3.4", shorttitle="MRB v3.4", overlay=true, max_bars_back=5000)

// ============================================================================
// MARKOV REGIME BIAS — Institutional Stack — Pine Script v6
// ============================================================================
//
// Five-layer signal engine:
//   Layer 1 — First-order Markov chain     (3×3 = 9-cell transition matrix)
//   Layer 2 — Second-order Markov chain    (9×3 = 27-cell transition matrix)
//   Layer 3 — VIX volatility regime        (CBOE:VIX vs 20-period SMA)
//   Layer 4 — Multi-timeframe confluence   (D + W + M raw state alignment)
//   Layer 5 — Shannon entropy scoring      (probability distribution certainty)
//
// Also tracks: regime duration (consecutive bars in current state).
//
// COMPOSITE PROBABILITY: weighted blend of all five layer outputs.
// CONFLUENCE SCORE: 0–5 integer — how many layers agree with primary bias.
// SIGNAL QUALITY: HIGH (conf ≥ 4/5 AND composite ≥ 62%)
//                 MEDIUM (conf ≥ 3/5 AND composite ≥ 58%)
//                 LOW (everything else)
//
// MACD FILTER (optional): HIGH signals additionally require MACD crossover
//   state to match bias direction.
//
// EXTENSION EXHAUSTION FILTER (optional): suppresses HIGH signals after
//   price extends N×ATR beyond the slow EMA. Resets on fast EMA retest.
//
// NEXT SESSION MODE (optional): plots carrot arrows at the START of each
//   new session showing the upcoming session's bias. Visual only —
//   no effect on performance tracking. Works for Daily, Weekly, Monthly.
//
// GAP PERFORMANCE TRACKING (optional): measures wins as overnight gap
//   (open vs prior close) rather than session direction (open → close).
//   Controlled independently of the visual next-session arrows.
//
// MARKERS: session-start triangles fire ONLY on HIGH quality signals.
//          Next-session carrot arrows fire ONLY on HIGH quality signals.
//          No marker = model says sit out.
//
// NO-LOOKAHEAD GUARANTEE:
//   All request.security calls use lookahead=barmerge.lookahead_off.
//   States derive from confirmed closed bars only. Zero repainting.
//
// ============================================================================

// ============================================================================
// SECTION 1 — INPUTS
// ============================================================================

var string grpRes     = "Regime Resolution"
var string grpState   = "State Classification"
var string grpMatrix  = "Transition Matrix"
var string grpInst    = "Institutional Stack"
var string grpBias    = "Bias Output"
var string grpVis     = "Visuals"
var string grpStats   = "Backtesting / Performance"
var string grpMacd    = "MACD Crossover Filter"
var string grpExhaust = "Extension Exhaustion Filter"

i_resolution = input.string("Weekly", "Regime Resolution",
     options=["Daily", "Weekly", "Monthly"], group=grpRes,
     tooltip="Daily: regime from closed daily bars (any chart). Weekly: from closed weekly bars. Monthly: from closed monthly bars. All dashboard labels update accordingly.")

i_lookback   = input.int  (5,    "State Lookback (bars)", minval=2, maxval=50, group=grpState,
     tooltip="Number of completed bars at the selected resolution to measure trailing return over.")
i_bullThresh = input.float(0.5,  "Bull Threshold (%)", minval=0.01, maxval=20.0, step=0.1, group=grpState)
i_bearThresh = input.float(0.5,  "Bear Threshold (%)", minval=0.01, maxval=20.0, step=0.1, group=grpState)
i_useAtrNorm = input.bool (true, "ATR-Normalise Thresholds", group=grpState,
     tooltip="Divides raw % return by ATR/price — instrument- and volatility-agnostic thresholds.")
i_atrLen     = input.int  (14,   "ATR Period (for normalisation)", minval=2, maxval=100, group=grpState)

i_matrixBars = input.int  (1000, "Matrix Lookback (bars; 0 = all)", minval=0, maxval=5000, group=grpMatrix,
     tooltip="Bars of history included in the first-order transition count. 0 = full available history.")

i_useSecondOrder = input.bool  (true,  "Second-Order Markov (27-cell matrix)", group=grpInst,
     tooltip="Tracks state PAIRS as the 'from' node — 9×3 = 27-cell matrix. Needs ≥3 confirmed bars to fire.")
i_useVix         = input.bool  (true,  "VIX Volatility Regime (CBOE:VIX)", group=grpInst,
     tooltip="High VIX (above SMA) shrinks bull confidence; low VIX boosts it. Requires CBOE:VIX data access.")
i_useMtf         = input.bool  (true,  "Multi-Timeframe Confluence (D+W+M)", group=grpInst,
     tooltip="Counts how many of Daily, Weekly, and Monthly raw states agree with the primary bias direction.")
i_useEntropy     = input.bool  (true,  "Entropy Confidence Scoring", group=grpInst,
     tooltip="Shannon entropy of the probability distribution. High entropy = uncertain. Normalized to 0-100%.")
i_useDuration    = input.bool  (true,  "Regime Duration Persistence", group=grpInst,
     tooltip="Longer consecutive duration in current state provides a mild persistence confidence boost.")
i_vixLen         = input.int  (20,    "VIX SMA Period", minval=5, maxval=100, group=grpInst)
i_w1             = input.float(0.30,  "Weight: 1st-Order Markov",   minval=0.0, maxval=1.0, step=0.05, group=grpInst)
i_w2             = input.float(0.25,  "Weight: 2nd-Order Markov",   minval=0.0, maxval=1.0, step=0.05, group=grpInst)
i_w3             = input.float(0.15,  "Weight: VIX Regime",         minval=0.0, maxval=1.0, step=0.05, group=grpInst)
i_w4             = input.float(0.15,  "Weight: MTF Confluence",     minval=0.0, maxval=1.0, step=0.05, group=grpInst)
i_w5             = input.float(0.15,  "Weight: Entropy Confidence", minval=0.0, maxval=1.0, step=0.05, group=grpInst)

i_biasThresh  = input.float(55.0, "1st-Order Bias Confidence Threshold (%)", minval=50.0, maxval=99.0, step=0.5, group=grpBias,
     tooltip="P(Bull) or P(Bear) must exceed this to register a directional bias from the first-order matrix.")
i_compThreshH = input.float(62.0, "HIGH Signal: Min Composite Probability (%)", minval=50.0, maxval=99.0, step=0.5, group=grpBias)
i_compThreshM = input.float(58.0, "MEDIUM Signal: Min Composite Probability (%)", minval=50.0, maxval=99.0, step=0.5, group=grpBias)
i_confThreshH = input.int  (4,   "HIGH Signal: Min Confluence Score (0-5)", minval=0, maxval=5, group=grpBias)
i_confThreshM = input.int  (3,   "MEDIUM Signal: Min Confluence Score (0-5)", minval=0, maxval=5, group=grpBias)
i_minSample   = input.int  (30,  "Min Transitions for Warning", minval=5, maxval=500, group=grpBias)

i_showTable      = input.bool  (false,       "Show Regime Bias Dashboard",    group=grpVis)
i_showMatrix     = input.bool  (false,       "Show Transition Matrix Grid",   group=grpVis)
i_showBgTint     = input.bool  (false,       "Show Background Tint",          group=grpVis)
i_showHistory    = input.bool  (false,       "Show Historical State Markers", group=grpVis)
i_nextSessionMode = input.bool (true,        "Show Next Session Bias Arrow",  group=grpVis,
     tooltip="Plots carrot arrows at the START of each new session showing the bias for that session. Appears on the same bar as the session triangle (opposite side so they never overlap). Works for Daily, Weekly, and Monthly resolutions. Visual only — does not affect performance tracking.")
i_tblPos      = input.string("Top Right", "Table Position",
     options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=grpVis)
i_colorBull   = input.color (color.new(#00c087, 0),  "Bull Colour",     group=grpVis)
i_colorBear   = input.color (color.new(#ff3b30, 0),  "Bear Colour",     group=grpVis)
i_colorSide   = input.color (color.new(#8e8e93, 0),  "Sideways Colour", group=grpVis)
i_bgAlpha     = input.int   (93, "Background Tint Opacity (0=solid, 100=invisible)", minval=70, maxval=100, group=grpVis)
i_showDayBias = input.bool  (true, "Show Bias Markers (HIGH quality only)", group=grpVis,
     tooltip="Plots markers ONLY on HIGH quality signals: green ▲ below bar = bullish, red ▼ above bar = bearish. No marker = no trade.")
i_colorNeutral = input.color(color.new(color.yellow, 0), "Neutral Colour", group=grpVis)
i_markerSize  = input.string("Normal", "Marker Size",
     options=["Tiny","Small","Normal","Large"], group=grpVis)

i_statsAllHist   = input.bool  (true,                          "All History",                    group=grpStats)
i_statsLastN     = input.bool  (true,                          "Last N Signals",                 group=grpStats)
i_lastNCount     = input.int   (50,                            "N (number of recent signals)",   group=grpStats, minval=5, maxval=500)
i_statsDateRange = input.bool  (true,                          "Date Range",                     group=grpStats)
i_drStart        = input.time  (timestamp("2025-01-01 00:00"), "Start Date",                     group=grpStats)
i_drEnd          = input.time  (timestamp("2026-12-31 23:59"), "End Date",                       group=grpStats)
i_gapMode        = input.bool  (false,                         "Gap Performance Tracking",       group=grpStats,
     tooltip="When ON, a win is measured as overnight gap in the signal direction (open vs prior close) rather than session direction (open to close). Independent of the Next Session Bias Arrow toggle.")
i_showStats  = input.bool  (false,         "Show Signal Performance Dashboard",                  group=grpStats)
i_statsPos   = input.string("Bottom Right","Stats Table Position",
     options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=grpStats)
i_statsTblSize = input.string("Small", "Signal Performance Table Size",
     options=["Tiny","Small","Normal","Large"], group=grpStats,
     tooltip="Controls text size in the Signal Performance dashboard. Small = current default. Normal and Large improve readability on smaller screens.")

var string grpEval = "Evaluation Dashboard"

i_showEval    = input.bool  (true,         "Show Evaluation Dashboard",        group=grpEval,
     tooltip="Compact summary for stock comparison: current signal direction, composite probability, confluence score, and Date Range performance stats including Avg Net Move.")
i_evalPos     = input.string("Bottom Right","Evaluation Dashboard Position",
     options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=grpEval)
i_evalTblSize = input.string("Small",      "Evaluation Dashboard Size",
     options=["Tiny","Small","Normal","Large"], group=grpEval,
     tooltip="Controls text size in the Evaluation Dashboard. Increase for larger, easier-to-read panels.")

i_useMacdFilter = input.bool  (false, "Enable MACD Crossover Filter",      group=grpMacd,
     tooltip="When ON, HIGH signals only fire when the MACD crossover state matches the Markov bias direction. Backtesting stats automatically reflect the filtered results.")
i_macdUseZL     = input.bool  (false, "Use Zero-Lag MACD",                 group=grpMacd,
     tooltip="Zero-lag EMA de-trends the source before smoothing, reducing indicator lag without changing the crossover logic.")
i_macdFast      = input.int   (12,   "Fast Length",   minval=1, maxval=200, group=grpMacd)
i_macdSlow      = input.int   (26,   "Slow Length",   minval=1, maxval=200, group=grpMacd)
i_macdSignal    = input.int   (9,    "Signal Length", minval=1, maxval=200, group=grpMacd)

i_useExhaustion  = input.bool  (true,  "Enable Extension Exhaustion Filter", group=grpExhaust,
     tooltip="When ON, suppresses HIGH signals after price extends beyond N×ATR from the slow EMA. Bull signals resume only after price retests the fast EMA from above; bear signals after price retests from below.")
i_exhaustAtrMult = input.float (3.0,  "ATR Multiplier (extension threshold)", minval=1.0, maxval=10.0, step=0.5, group=grpExhaust)
i_exhaustEma20   = input.int   (20,   "Extension EMA Period (slow)",           minval=5,   maxval=200,            group=grpExhaust)
i_exhaustEma10   = input.int   (10,   "Reset EMA Period (fast)",               minval=2,   maxval=100,            group=grpExhaust)

// ============================================================================
// SECTION 2 — RESOLUTION DATA (CONFIRMED BARS, NO LOOKAHEAD)
// ============================================================================

string _res = i_resolution == "Weekly" ? "W" : i_resolution == "Monthly" ? "M" : "D"

f_stateAtRes() =>
    float priceNow  = close
    float priceBack = close[i_lookback]
    float retPct    = not na(priceBack) and priceBack != 0.0
                      ? (priceNow - priceBack) / priceBack * 100.0 : 0.0
    float atrVal     = ta.atr(i_atrLen)
    float normFactor = i_useAtrNorm and not na(atrVal) and atrVal > 0.0 and priceNow > 0.0
                       ? atrVal / priceNow * 100.0 : 1.0
    float adjReturn  = i_useAtrNorm ? retPct / math.max(normFactor, 0.0001) : retPct
    // 0 = BULL, 1 = BEAR, 2 = SIDEWAYS
    adjReturn > i_bullThresh ? 0 : adjReturn < -i_bearThresh ? 1 : 2

int resState  = request.security(syminfo.tickerid, _res, f_stateAtRes(), lookahead=barmerge.lookahead_off)
int resBarIdx = request.security(syminfo.tickerid, _res, bar_index,      lookahead=barmerge.lookahead_off)

// MTF raw states fetched at all three resolutions simultaneously
int stateD = request.security(syminfo.tickerid, "D", f_stateAtRes(), lookahead=barmerge.lookahead_off)
int stateW = request.security(syminfo.tickerid, "W", f_stateAtRes(), lookahead=barmerge.lookahead_off)
int stateM = request.security(syminfo.tickerid, "M", f_stateAtRes(), lookahead=barmerge.lookahead_off)

// VIX data
float vixClose = request.security("CBOE:VIX", "D", close,                  lookahead=barmerge.lookahead_off)
float vixSma   = request.security("CBOE:VIX", "D", ta.sma(close, i_vixLen), lookahead=barmerge.lookahead_off)

// New confirmed bar detection
var int lastResBarIdx = na
bool isResUpdate = not na(resBarIdx) and (na(lastResBarIdx) or resBarIdx != lastResBarIdx)
if isResUpdate
    lastResBarIdx := resBarIdx

// ============================================================================
// SECTION 3 — FIRST-ORDER TRANSITION MATRIX (9-cell)
// ============================================================================
// index = fromState * 3 + toState   (BULL=0, BEAR=1, SIDEWAYS=2)

var float[] transCount  = array.new_float(9, 0.0)
var int[]   stateBuffer = array.new_int(0)

if isResUpdate
    array.push(stateBuffer, resState)
    int bufLen = array.size(stateBuffer)

    if bufLen >= 2
        int fromSt1 = array.get(stateBuffer, bufLen - 2)
        int toSt1   = array.get(stateBuffer, bufLen - 1)
        array.set(transCount, fromSt1 * 3 + toSt1,
                  array.get(transCount, fromSt1 * 3 + toSt1) + 1.0)

    int bufCap = i_matrixBars > 0 ? i_matrixBars + 1 : 5001
    if i_matrixBars > 0 and bufLen > bufCap
        int removedFrom = array.shift(stateBuffer)
        int newOldest   = array.get(stateBuffer, 0)
        int removeIdx   = removedFrom * 3 + newOldest
        array.set(transCount, removeIdx, math.max(0.0, array.get(transCount, removeIdx) - 1.0))

f_probRow(int fromSt, float[] counts) =>
    float pB    = array.get(counts, fromSt * 3 + 0)
    float pBr   = array.get(counts, fromSt * 3 + 1)
    float pS    = array.get(counts, fromSt * 3 + 2)
    float rowSum = pB + pBr + pS
    float rBull = rowSum > 0.0 ? pB  / rowSum * 100.0 : 33.33
    float rBear = rowSum > 0.0 ? pBr / rowSum * 100.0 : 33.33
    float rSide = rowSum > 0.0 ? pS  / rowSum * 100.0 : 33.33
    [rBull, rBear, rSide]

int curState = resState

[pBull0, pBear0, pSide0] = f_probRow(0, transCount)
[pBull1, pBear1, pSide1] = f_probRow(1, transCount)
[pBull2, pBear2, pSide2] = f_probRow(2, transCount)

float pBullNext = curState == 0 ? pBull0 : curState == 1 ? pBull1 : pBull2
float pBearNext = curState == 0 ? pBear0 : curState == 1 ? pBear1 : pBear2
float pSideNext = curState == 0 ? pSide0 : curState == 1 ? pSide1 : pSide2

float totalTrans = 0.0
for i = 0 to 8
    totalTrans += array.get(transCount, i)
bool lowSample = totalTrans < float(i_minSample)

int biasDir = pBullNext >= i_biasThresh ? 1 : pBearNext >= i_biasThresh ? -1 : 0

// ============================================================================
// SECTION 4 — SECOND-ORDER MARKOV CHAIN (27-cell)
// ============================================================================
// "from" node = prior state PAIR: prevState*3 + curState  → values 0-8
// index = fromPair * 3 + toState

var float[] trans2 = array.new_float(27, 0.0)

if isResUpdate
    int bufLen2 = array.size(stateBuffer)
    if bufLen2 >= 3
        int prevSt2  = array.get(stateBuffer, bufLen2 - 3)
        int fromSt2  = array.get(stateBuffer, bufLen2 - 2)
        int toSt2    = array.get(stateBuffer, bufLen2 - 1)
        int fromPair = prevSt2 * 3 + fromSt2
        int idx2     = fromPair * 3 + toSt2
        array.set(trans2, idx2, array.get(trans2, idx2) + 1.0)

// Read second-order probs for current state pair
float p2BullNext = 33.33
float p2BearNext = 33.33
float p2SideNext = 33.33

int bufLenNow = array.size(stateBuffer)
if i_useSecondOrder and bufLenNow >= 2
    int prevStNow = array.get(stateBuffer, bufLenNow - 2)
    int curStNow  = array.get(stateBuffer, bufLenNow - 1)
    int pairNow   = prevStNow * 3 + curStNow
    float s2B   = array.get(trans2, pairNow * 3 + 0)
    float s2Br  = array.get(trans2, pairNow * 3 + 1)
    float s2S   = array.get(trans2, pairNow * 3 + 2)
    float s2Sum = s2B + s2Br + s2S
    if s2Sum > 0.0
        p2BullNext := s2B  / s2Sum * 100.0
        p2BearNext := s2Br / s2Sum * 100.0
        p2SideNext := s2S  / s2Sum * 100.0

// ============================================================================
// SECTION 5 — VIX VOLATILITY REGIME
// ============================================================================

bool isHighVol = not na(vixClose) and not na(vixSma) and vixClose > vixSma

// VIX directional score for composite blend
// High vol favors bears; low vol favors bulls
float vixBullScore = i_useVix ? (isHighVol ? 42.0 : 62.0) : 50.0
float vixBearScore = i_useVix ? (isHighVol ? 62.0 : 42.0) : 50.0

// ============================================================================
// SECTION 6 — MULTI-TIMEFRAME CONFLUENCE
// ============================================================================

int biasDirD = stateD == 0 ? 1 : stateD == 1 ? -1 : 0
int biasDirW = stateW == 0 ? 1 : stateW == 1 ? -1 : 0
int biasDirM = stateM == 0 ? 1 : stateM == 1 ? -1 : 0

// Count how many of D/W/M agree with the primary bias direction
int mtfScore = 0
if i_useMtf
    if biasDirD == biasDir
        mtfScore := mtfScore + 1
    if biasDirW == biasDir
        mtfScore := mtfScore + 1
    if biasDirM == biasDir
        mtfScore := mtfScore + 1

// MTF probability contribution: 0→33%, 1→44%, 2→55%, 3→67%
float mtfProb = i_useMtf ? 33.33 + float(mtfScore) * 11.11 : 50.0

// ============================================================================
// SECTION 7 — ENTROPY / UNCERTAINTY SCORING
// ============================================================================

float _p1 = math.max(pBullNext / 100.0, 0.0001)
float _p2 = math.max(pBearNext / 100.0, 0.0001)
float _p3 = math.max(pSideNext / 100.0, 0.0001)
float rawEntropy  = -(_p1 * math.log(_p1) + _p2 * math.log(_p2) + _p3 * math.log(_p3))
float maxEntropy  = math.log(3.0)
float entropyNorm = math.min(rawEntropy / maxEntropy, 1.0)
// Confidence = 1 - normalized entropy (low entropy = more certain = higher confidence)
float entropyConf = (1.0 - entropyNorm) * 100.0

// ============================================================================
// SECTION 8 — REGIME DURATION
// ============================================================================

var int regimeDuration = 0
var int lastState      = na

if isResUpdate
    if na(lastState) or resState != lastState
        regimeDuration := 1
        lastState      := resState
    else
        regimeDuration += 1

// Duration persistence boost added to compositeProb (up to +4% at 14+ bars)
float durationBoost = i_useDuration ? math.min(float(regimeDuration) * 0.3, 4.0) : 0.0

// ============================================================================
// SECTION 8B — MACD CROSSOVER FILTER
// ============================================================================
// MACD state (above/below signal line) must match bias direction when filter
// is enabled. Uses standard or zero-lag EMA depending on i_macdUseZL.

f_zlema(float src, int len) =>
    int lag = math.round((len - 1) / 2)
    ta.ema(2.0 * src - src[lag], len)

float _mFast   = i_macdUseZL ? f_zlema(close, i_macdFast) : ta.ema(close, i_macdFast)
float _mSlow   = i_macdUseZL ? f_zlema(close, i_macdSlow) : ta.ema(close, i_macdSlow)
float macdLine = _mFast - _mSlow
float macdSig  = ta.ema(macdLine, i_macdSignal)

bool macdIsBull = macdLine > macdSig   // MACD above signal = bullish state
bool macdIsBear = macdLine < macdSig   // MACD below signal = bearish state

// When filter is off, macdAligned is always true → no change to existing logic
bool macdAligned = not i_useMacdFilter or
                   (biasDir ==  1 and macdIsBull) or
                   (biasDir == -1 and macdIsBear)

// ============================================================================
// SECTION 8C — EXTENSION EXHAUSTION FILTER
// ============================================================================
// Bull exhaustion: high taps ema20 + N×ATR → suppress bullish HIGH signals
//   until low taps ema10 (price pulled back into EMA cloud).
// Bear exhaustion: low taps ema20 - N×ATR → suppress bearish HIGH signals
//   until high taps ema10 (price bounced back into EMA cloud).
// When filter is off, both flags stay false → no effect on signal logic.

float ema20      = ta.ema(close, i_exhaustEma20)
float ema10      = ta.ema(close, i_exhaustEma10)
float exhaustAtr = ta.atr(i_atrLen)

var bool bullExhausted = false
var bool bearExhausted = false

// Snapshot BEFORE updating — signal gate uses prior-bar state so a same-bar
// EMA10 reset cannot unlock the signal on the very bar the retest occurs.
// Reset must be confirmed on a closed bar before the next signal can fire.
bool bullExhaustedAtOpen = bullExhausted
bool bearExhaustedAtOpen = bearExhausted

// barstate.isconfirmed gates exhaustion to closed bars only.
// On an open bar (e.g. live intraweek price on a 1W chart), the flags stay
// frozen at their prior-close values, keeping the signal stable all week.
if i_useExhaustion and barstate.isconfirmed
    if high >= ema20 + i_exhaustAtrMult * exhaustAtr
        bullExhausted := true
    if bullExhausted and low <= ema10
        bullExhausted := false
    if low <= ema20 - i_exhaustAtrMult * exhaustAtr
        bearExhausted := true
    if bearExhausted and high >= ema10
        bearExhausted := false

// ============================================================================
// SECTION 9 — COMPOSITE PROBABILITY & CONFLUENCE SCORE
// ============================================================================

// Primary directional probability from first-order matrix
float primaryProb   = biasDir ==  1 ? pBullNext : biasDir == -1 ? pBearNext : pSideNext
// Second-order directional probability
float secondaryProb = biasDir ==  1 ? p2BullNext : biasDir == -1 ? p2BearNext : p2SideNext
// VIX aligned to primary bias direction
float vixAlignScore = biasDir ==  1 ? vixBullScore : biasDir == -1 ? vixBearScore : 50.0

// Normalize weights so they always sum to 1
float wSum = math.max(i_w1 + i_w2 + i_w3 + i_w4 + i_w5, 0.001)
float w1n  = i_w1 / wSum
float w2n  = i_w2 / wSum
float w3n  = i_w3 / wSum
float w4n  = i_w4 / wSum
float w5n  = i_w5 / wSum

float compositeProb = w1n * primaryProb +
                      w2n * (i_useSecondOrder ? secondaryProb : primaryProb) +
                      w3n * vixAlignScore +
                      w4n * mtfProb +
                      w5n * (i_useEntropy ? entropyConf : 50.0) +
                      (biasDir != 0 ? durationBoost : 0.0)

// Confluence score: 0–5 (each enabled layer that agrees with primary bias adds 1)
int confScore = 0

// L1: first-order primary probability crosses bias threshold
if primaryProb >= i_biasThresh
    confScore := confScore + 1

// L2: second-order agrees
if i_useSecondOrder and secondaryProb >= i_biasThresh
    confScore := confScore + 1

// L3: VIX agrees (low vol + bull, or high vol + bear)
if i_useVix
    if (biasDir == 1 and not isHighVol) or (biasDir == -1 and isHighVol)
        confScore := confScore + 1

// L4: MTF majority agrees (≥ 2 of 3 timeframes)
if i_useMtf and mtfScore >= 2
    confScore := confScore + 1

// L5: entropy confidence is high (distribution is concentrated)
if i_useEntropy and entropyConf > 55.0
    confScore := confScore + 1

// Signal Quality — the single decision gate
// Uses AtOpen snapshot so a same-bar EMA10 retest cannot unlock the signal mid-bar
bool notExhausted    = not i_useExhaustion or (biasDir == 1 ? not bullExhaustedAtOpen : not bearExhaustedAtOpen)
bool isSignalHigh    = biasDir != 0 and confScore >= i_confThreshH and compositeProb >= i_compThreshH and macdAligned and notExhausted
// Raw HIGH: meets composite + confluence + bias thresholds but ignores exhaustion/MACD filters.
// Used by evalDash to explain when a filter is downgrading an otherwise-HIGH signal.
bool isSignalHighRaw = biasDir != 0 and confScore >= i_confThreshH and compositeProb >= i_compThreshH
bool isSignalMedium  = biasDir != 0 and not isSignalHigh and confScore >= i_confThreshM and compositeProb >= i_compThreshM
string sigQuality    = isSignalHigh ? "HIGH" : isSignalMedium ? "MEDIUM" : "LOW"

// ============================================================================
// SECTION 9B — PERFORMANCE TRACKING
// ============================================================================
// Normal mode  : win = same-bar open→close in the signal direction.
// Gap mode     : win = overnight gap in signal direction (open vs prior close).
//                Bull win: open > close[1]   Bear win: open < close[1]
//
// i_gapMode controls win measurement independently of i_nextSessionMode.
// Only HIGH quality signals counted — matches the chart marker gate.
// barstate.isconfirmed ensures the bar is fully closed before counting.

var int   ahBullW   = 0
var int   ahBullL   = 0
var int   ahBearW   = 0
var int   ahBearL   = 0
var int   ahStreak  = 0
var int   ahLastRes = 0   // 1 = last was a win, -1 = last was a loss

var int   drBullW   = 0
var int   drBullL   = 0
var int   drBearW   = 0
var int   drBearL   = 0

var float[] lnArr    = array.new_float(0)
var float[] lnAmtArr = array.new_float(0)

var float ahBullWAmt = 0.0
var float ahBullLAmt = 0.0
var float ahBearWAmt = 0.0
var float ahBearLAmt = 0.0

var float drBullWAmt = 0.0
var float drBullLAmt = 0.0
var float drBearWAmt = 0.0
var float drBearLAmt = 0.0

if isResUpdate and isSignalHigh and biasDir != 0 and barstate.isconfirmed
    bool _gapWin     = (biasDir == 1 and open > close[1]) or (biasDir == -1 and open < close[1])
    bool _sessionWin = (biasDir == 1 and close >= open)   or (biasDir == -1 and close <= open)
    bool isWin       = i_gapMode ? _gapWin : _sessionWin
    int  thisRes = isWin ? 1 : -1

    // Signed price move in signal direction (positive = win, negative = loss)
    float _sessionMove = biasDir == 1 ? (close - open) : (open - close)
    float _gapMove     = biasDir == 1 ? (open - close[1]) : (close[1] - open)
    float priceMove    = i_gapMode ? _gapMove : _sessionMove

    // All History
    if biasDir == 1
        ahBullW    += isWin ? 1         : 0
        ahBullL    += isWin ? 0         : 1
        ahBullWAmt += isWin ? priceMove : 0.0
        ahBullLAmt += isWin ? 0.0       : priceMove
    else
        ahBearW    += isWin ? 1         : 0
        ahBearL    += isWin ? 0         : 1
        ahBearWAmt += isWin ? priceMove : 0.0
        ahBearLAmt += isWin ? 0.0       : priceMove
    ahStreak  := thisRes == ahLastRes ? ahStreak + 1 : 1
    ahLastRes := thisRes

    // Date Range
    if time >= i_drStart and time <= i_drEnd
        if biasDir == 1
            drBullW    += isWin ? 1         : 0
            drBullL    += isWin ? 0         : 1
            drBullWAmt += isWin ? priceMove : 0.0
            drBullLAmt += isWin ? 0.0       : priceMove
        else
            drBearW    += isWin ? 1         : 0
            drBearL    += isWin ? 0         : 1
            drBearWAmt += isWin ? priceMove : 0.0
            drBearLAmt += isWin ? 0.0       : priceMove

    // Last N (rolling array capped at i_lastNCount)
    // Encoding: 1.0=bull-win  -1.0=bull-loss  2.0=bear-win  -2.0=bear-loss
    float code = biasDir == 1 ? (isWin ? 1.0 : -1.0) : (isWin ? 2.0 : -2.0)
    array.push(lnArr, code)
    if array.size(lnArr) > i_lastNCount
        array.shift(lnArr)
    array.push(lnAmtArr, priceMove)
    if array.size(lnAmtArr) > i_lastNCount
        array.shift(lnAmtArr)

// ============================================================================
// SECTION 11 — LABELS & DERIVED DISPLAY VALUES
// ============================================================================

string stateLabel = curState == 0 ? "BULL" : curState == 1 ? "BEAR" : "SIDEWAYS"
color  stateColor = curState == 0 ? i_colorBull : curState == 1 ? i_colorBear : i_colorSide
string biasLabel  = biasDir ==  1 ? "▲  BULLISH" : biasDir == -1 ? "▼  BEARISH" : "◆  NEUTRAL"
color  biasColor  = biasDir ==  1 ? i_colorBull  : biasDir == -1 ? i_colorBear  : i_colorSide

// ============================================================================
// SECTION 12 — BACKGROUND TINT
// ============================================================================

bgcolor(i_showBgTint ? (biasDir == 1 ? color.new(i_colorBull, i_bgAlpha) : biasDir == -1 ? color.new(i_colorBear, i_bgAlpha) : color.new(i_colorSide, i_bgAlpha)) : na, title="Bias Background Tint")

// ============================================================================
// SECTION 13 — VISUAL MARKERS
// ============================================================================

// Historical state dots (tiny, every bar — for auditing)
plotshape(i_showHistory and curState == 0, title="State: BULL",
          style=shape.triangleup,   location=location.belowbar,
          color=i_colorBull, size=size.tiny)
plotshape(i_showHistory and curState == 1, title="State: BEAR",
          style=shape.triangledown, location=location.abovebar,
          color=i_colorBear, size=size.tiny)

// Session-start bias markers — HIGH quality signals only
// plotshape size must be const in v6; one call per size, gated by i_markerSize
plotshape(i_showDayBias and isResUpdate and biasDir ==  1 and isSignalHigh and i_markerSize == "Tiny",   title="Session Bias: BULLISH (HIGH)", style=shape.triangleup,   location=location.belowbar,  color=i_colorBull, size=size.tiny)
plotshape(i_showDayBias and isResUpdate and biasDir ==  1 and isSignalHigh and i_markerSize == "Small",  title="Session Bias: BULLISH (HIGH)", style=shape.triangleup,   location=location.belowbar,  color=i_colorBull, size=size.small)
plotshape(i_showDayBias and isResUpdate and biasDir ==  1 and isSignalHigh and i_markerSize == "Normal", title="Session Bias: BULLISH (HIGH)", style=shape.triangleup,   location=location.belowbar,  color=i_colorBull, size=size.normal)
plotshape(i_showDayBias and isResUpdate and biasDir ==  1 and isSignalHigh and i_markerSize == "Large",  title="Session Bias: BULLISH (HIGH)", style=shape.triangleup,   location=location.belowbar,  color=i_colorBull, size=size.large)

plotshape(i_showDayBias and isResUpdate and biasDir == -1 and isSignalHigh and i_markerSize == "Tiny",   title="Session Bias: BEARISH (HIGH)", style=shape.triangledown, location=location.abovebar, color=i_colorBear, size=size.tiny)
plotshape(i_showDayBias and isResUpdate and biasDir == -1 and isSignalHigh and i_markerSize == "Small",  title="Session Bias: BEARISH (HIGH)", style=shape.triangledown, location=location.abovebar, color=i_colorBear, size=size.small)
plotshape(i_showDayBias and isResUpdate and biasDir == -1 and isSignalHigh and i_markerSize == "Normal", title="Session Bias: BEARISH (HIGH)", style=shape.triangledown, location=location.abovebar, color=i_colorBear, size=size.normal)
plotshape(i_showDayBias and isResUpdate and biasDir == -1 and isSignalHigh and i_markerSize == "Large",  title="Session Bias: BEARISH (HIGH)", style=shape.triangledown, location=location.abovebar, color=i_colorBear, size=size.large)

// Carrot arrows draw ON the signal bar (offset=0 / no offset).
// Condition fires on bar N when isResUpdate + isSignalHigh are true AND bar is confirmed.
// Shape draws on bar N itself — immediately visible the moment the session closes.
// Bull carrots above bar, bear carrots below bar — opposite sides from session
// triangles (triangles are below/above) so both render without overlap on the same bar.
// Replay: carrot draws on bar N which exists at the replay position — always visible.
plotshape(i_nextSessionMode and barstate.isconfirmed and isResUpdate and biasDir ==  1 and isSignalHigh and i_markerSize == "Tiny",   title="Next Session: BULLISH (HIGH)", style=shape.arrowup,   location=location.abovebar, color=i_colorBull, size=size.tiny)
plotshape(i_nextSessionMode and barstate.isconfirmed and isResUpdate and biasDir ==  1 and isSignalHigh and i_markerSize == "Small",  title="Next Session: BULLISH (HIGH)", style=shape.arrowup,   location=location.abovebar, color=i_colorBull, size=size.small)
plotshape(i_nextSessionMode and barstate.isconfirmed and isResUpdate and biasDir ==  1 and isSignalHigh and i_markerSize == "Normal", title="Next Session: BULLISH (HIGH)", style=shape.arrowup,   location=location.abovebar, color=i_colorBull, size=size.normal)
plotshape(i_nextSessionMode and barstate.isconfirmed and isResUpdate and biasDir ==  1 and isSignalHigh and i_markerSize == "Large",  title="Next Session: BULLISH (HIGH)", style=shape.arrowup,   location=location.abovebar, color=i_colorBull, size=size.large)

plotshape(i_nextSessionMode and barstate.isconfirmed and isResUpdate and biasDir == -1 and isSignalHigh and i_markerSize == "Tiny",   title="Next Session: BEARISH (HIGH)", style=shape.arrowdown, location=location.belowbar, color=i_colorBear, size=size.tiny)
plotshape(i_nextSessionMode and barstate.isconfirmed and isResUpdate and biasDir == -1 and isSignalHigh and i_markerSize == "Small",  title="Next Session: BEARISH (HIGH)", style=shape.arrowdown, location=location.belowbar, color=i_colorBear, size=size.small)
plotshape(i_nextSessionMode and barstate.isconfirmed and isResUpdate and biasDir == -1 and isSignalHigh and i_markerSize == "Normal", title="Next Session: BEARISH (HIGH)", style=shape.arrowdown, location=location.belowbar, color=i_colorBear, size=size.normal)
plotshape(i_nextSessionMode and barstate.isconfirmed and isResUpdate and biasDir == -1 and isSignalHigh and i_markerSize == "Large",  title="Next Session: BEARISH (HIGH)", style=shape.arrowdown, location=location.belowbar, color=i_colorBear, size=size.large)

// ============================================================================
// SECTION 13B — LAST-N STATS + DISPLAY HELPERS
// ============================================================================

// Recompute Last-N win/loss counts from rolling array on every bar
int lnBullW = 0
int lnBullL = 0
int lnBearW = 0
int lnBearL = 0
int lnSz    = array.size(lnArr)
if i_statsLastN and lnSz > 0
    for i = 0 to lnSz - 1
        float v = array.get(lnArr, i)
        if v == 1.0
            lnBullW := lnBullW + 1
        else if v == -1.0
            lnBullL := lnBullL + 1
        else if v == 2.0
            lnBearW := lnBearW + 1
        else
            lnBearL := lnBearL + 1

// Recompute Last-N price move amounts from parallel rolling array
float lnWinAmt  = 0.0
float lnLossAmt = 0.0
int   lnAmtSz   = array.size(lnAmtArr)
if i_statsLastN and lnAmtSz > 0
    for i = 0 to lnAmtSz - 1
        float av = array.get(lnAmtArr, i)
        if av >= 0.0
            lnWinAmt  += av
        else
            lnLossAmt += av

f_wr(int w, int l) =>
    int tot = w + l
    tot == 0 ? "  -  " : str.tostring(math.round(float(w) / float(tot) * 100.0)) + "%"

f_wl(int w, int l) =>
    str.tostring(w) + "W  " + str.tostring(l) + "L"

f_fmtAmt(float v) =>
    string s = str.tostring(math.abs(v), "0.00")
    v < 0.0 ? "-" + s : "+" + s

f_fmtAvg(float total, int count) =>
    count == 0 ? "--" : f_fmtAmt(total / float(count))

// ============================================================================
// SECTION 14 — REGIME BIAS DASHBOARD (24 rows × 4 cols)
// ============================================================================

string _resTag       = i_resolution == "Weekly"  ? "W" : i_resolution == "Monthly" ? "M" : "D"
string _hdrLabel     = "MARKOV REGIME BIAS  [" + _resTag + "]"
string _sessionLbl   = i_resolution == "Weekly" ? "This Week's Bias" : i_resolution == "Monthly" ? "This Month's Bias" : "Today's Session Bias"
string _nextLbl      = i_resolution == "Weekly" ? "Next Week's Bias" : i_resolution == "Monthly" ? "Next Month's Bias" : "Tomorrow's Bias"
string _pBullLbl     = i_resolution == "Weekly" ? "P(Bull) next week" : i_resolution == "Monthly" ? "P(Bull) next month" : "P(Bull) tomorrow"
string _pBearLbl     = i_resolution == "Weekly" ? "P(Bear) next week" : i_resolution == "Monthly" ? "P(Bear) next month" : "P(Bear) tomorrow"
string _pSideLbl     = i_resolution == "Weekly" ? "P(Side) next week" : i_resolution == "Monthly" ? "P(Side) next month" : "P(Side) tomorrow"
string _lookbackUnit = i_resolution == "Weekly" ? "w" : i_resolution == "Monthly" ? "m" : "d"
string _s2Label      = biasDir == 1 ? "2nd-Order P(Bull)" : biasDir == -1 ? "2nd-Order P(Bear)" : "2nd-Order P(Side)"
float  _s2Prob       = biasDir ==  1 ? p2BullNext : biasDir == -1 ? p2BearNext : p2SideNext

string tblPosStr = i_tblPos
var table dash = table.new(
     tblPosStr == "Top Left"     ? position.top_left     :
     tblPosStr == "Bottom Right" ? position.bottom_right :
     tblPosStr == "Bottom Left"  ? position.bottom_left  : position.top_right,
     4, 24,
     border_width=1, border_color=color.new(color.gray, 70),
     frame_width=2,  frame_color=color.new(color.gray, 50))

var table statsDash = table.new(
     i_statsPos == "Top Left"     ? position.top_left     :
     i_statsPos == "Bottom Right" ? position.bottom_right :
     i_statsPos == "Bottom Left"  ? position.bottom_left  : position.top_right,
     4, 22,
     border_width=1, border_color=color.new(color.gray, 70),
     frame_width=2,  frame_color=color.new(color.gray, 50))

var table evalDash = table.new(
     i_evalPos == "Top Right"    ? position.top_right    :
     i_evalPos == "Bottom Right" ? position.bottom_right :
     i_evalPos == "Bottom Left"  ? position.bottom_left  : position.top_left,
     4, 12,
     border_width=1, border_color=color.new(color.gray, 70),
     frame_width=2,  frame_color=color.new(color.gray, 50))

if barstate.islast

    // ── SECTION 14: REGIME BIAS DASHBOARD ────────────────────────────────────
    if i_showTable
        color hdrBg   = color.new(#0d1b2a, 5)
        color rowBg   = color.new(#0d1b2a, 20)
        color txtDim  = color.new(color.white, 15)
        color txtFull = color.white

        // ── Row 0: Title ──────────────────────────────────────────────────────
        table.cell(dash, 0, 0, _hdrLabel + "  ■ INSTITUTIONAL",
                   bgcolor=hdrBg, text_color=txtFull,
                   text_size=size.small, text_halign=text.align_center)
        table.merge_cells(dash, 0, 0, 3, 0)

        // ── Row 1: Current State + duration ───────────────────────────────────
        table.cell(dash, 0, 1, "Current State", bgcolor=rowBg, text_color=txtDim,
                   text_size=size.small, text_halign=text.align_left)
        table.merge_cells(dash, 0, 1, 1, 1)
        table.cell(dash, 2, 1, stateLabel + "  (" + str.tostring(regimeDuration) + " bars)",
                   bgcolor=color.new(stateColor, 20), text_color=txtFull,
                   text_size=size.normal, text_halign=text.align_center)
        table.merge_cells(dash, 2, 1, 3, 1)

        // ── Row 2: Today's Bias ────────────────────────────────────────────────
        table.cell(dash, 0, 2, _sessionLbl, bgcolor=rowBg, text_color=txtDim,
                   text_size=size.small, text_halign=text.align_left)
        table.merge_cells(dash, 0, 2, 1, 2)
        table.cell(dash, 2, 2, biasLabel,
                   bgcolor=color.new(biasColor, 10), text_color=biasColor,
                   text_size=size.normal, text_halign=text.align_center)
        table.merge_cells(dash, 2, 2, 3, 2)

        // ── Row 3: Signal Quality ──────────────────────────────────────────────
        table.cell(dash, 0, 3, "Signal Quality", bgcolor=rowBg, text_color=txtDim,
                   text_size=size.small, text_halign=text.align_left)
        table.merge_cells(dash, 0, 3, 1, 3)
        color sqBg  = isSignalHigh   ? color.new(i_colorBull,  5) :
                      isSignalMedium ? color.new(color.orange, 10) : color.new(color.gray, 25)
        color sqTxt = isSignalHigh   ? color.white :
                      isSignalMedium ? color.new(color.orange, 0) : color.new(color.gray, 0)
        table.cell(dash, 2, 3, sigQuality,
                   bgcolor=sqBg, text_color=sqTxt,
                   text_size=size.normal, text_halign=text.align_center)
        table.merge_cells(dash, 2, 3, 3, 3)

        // ── Row 4: MACD Filter ─────────────────────────────────────────────────
        table.cell(dash, 0, 4, "MACD Filter" + (i_useMacdFilter ? (i_macdUseZL ? "  (ZL)" : "") : "  (off)"),
                   bgcolor=rowBg, text_color=txtDim, text_size=size.small, text_halign=text.align_left)
        table.merge_cells(dash, 0, 4, 1, 4)
        string _macdStr  = not i_useMacdFilter ? "(filter off)" :
                           macdIsBull and biasDir ==  1 ? "BULLISH ✓  aligned" :
                           macdIsBear and biasDir == -1 ? "BEARISH ✓  aligned" :
                           macdIsBull                   ? "BULLISH  — no match" :
                           macdIsBear                   ? "BEARISH  — no match" : "flat"
        color _macdBg    = not i_useMacdFilter ? color.new(color.gray, 45) :
                           macdAligned          ? color.new(#005f73, 10)   : color.new(color.orange, 10)
        color _macdTxt   = not i_useMacdFilter ? color.new(color.white, 25) : txtFull
        table.cell(dash, 2, 4, _macdStr,
                   bgcolor=_macdBg, text_color=_macdTxt,
                   text_size=size.small, text_halign=text.align_center)
        table.merge_cells(dash, 2, 4, 3, 4)

        // ── Row 5: Extension Exhaustion Filter ────────────────────────────────
        table.cell(dash, 0, 5, "Ext Exhaustion" + (i_useExhaustion ? "" : "  (off)"),
                   bgcolor=rowBg, text_color=txtDim, text_size=size.small, text_halign=text.align_left)
        table.merge_cells(dash, 0, 5, 1, 5)
        string _exhStr = not i_useExhaustion ? "(filter off)" :
                         bullExhausted        ? "BULL EXHAUSTED  —  suppressed" :
                         bearExhausted        ? "BEAR EXHAUSTED  —  suppressed" : "clear  ✓"
        color _exhBg   = not i_useExhaustion              ? color.new(color.gray,   45) :
                         (bullExhausted or bearExhausted) ? color.new(color.orange, 10) : color.new(#005f73, 10)
        color _exhTxt  = not i_useExhaustion ? color.new(color.white, 25) : txtFull
        table.cell(dash, 2, 5, _exhStr,
                   bgcolor=_exhBg, text_color=_exhTxt,
                   text_size=size.small, text_halign=text.align_center)
        table.merge_cells(dash, 2, 5, 3, 5)

        // ── Row 6: Composite Probability ──────────────────────────────────────
        table.cell(dash, 0, 6, "Composite Probability", bgcolor=rowBg, text_color=txtDim,
                   text_size=size.small, text_halign=text.align_left)
        table.merge_cells(dash, 0, 6, 1, 6)
        color compBg = compositeProb >= i_compThreshH ? color.new(#005f73, 10) :
                       compositeProb >= i_compThreshM ? color.new(color.orange, 10) : color.new(color.gray, 30)
        table.cell(dash, 2, 6, str.tostring(compositeProb, "#.1") + "%",
                   bgcolor=compBg, text_color=txtFull,
                   text_size=size.normal, text_halign=text.align_center)
        table.merge_cells(dash, 2, 6, 3, 6)

        // ── Row 7: Confluence Score ────────────────────────────────────────────
        table.cell(dash, 0, 7, "Confluence Score", bgcolor=rowBg, text_color=txtDim,
                   text_size=size.small, text_halign=text.align_left)
        table.merge_cells(dash, 0, 7, 1, 7)
        color confBg = confScore >= i_confThreshH ? color.new(#005f73, 10) :
                       confScore >= i_confThreshM ? color.new(color.orange, 10) : color.new(color.gray, 30)
        table.cell(dash, 2, 7, str.tostring(confScore) + " / 5",
                   bgcolor=confBg, text_color=txtFull,
                   text_size=size.normal, text_halign=text.align_center)
        table.merge_cells(dash, 2, 7, 3, 7)

        // ── Row 8: P(Bull) ────────────────────────────────────────────────────
        table.cell(dash, 0, 8, _pBullLbl, bgcolor=rowBg, text_color=txtDim,
                   text_size=size.small, text_halign=text.align_left)
        table.merge_cells(dash, 0, 8, 1, 8)
        table.cell(dash, 2, 8, str.tostring(pBullNext, "#.1") + "%",
                   bgcolor=color.new(color.green, 20), text_color=txtFull,
                   text_size=size.normal, text_halign=text.align_center)
        table.merge_cells(dash, 2, 8, 3, 8)

        // ── Row 9: P(Bear) ────────────────────────────────────────────────────
        table.cell(dash, 0, 9, _pBearLbl, bgcolor=rowBg, text_color=txtDim,
                   text_size=size.small, text_halign=text.align_left)
        table.merge_cells(dash, 0, 9, 1, 9)
        table.cell(dash, 2, 9, str.tostring(pBearNext, "#.1") + "%",
                   bgcolor=color.new(color.red, 20), text_color=txtFull,
                   text_size=size.normal, text_halign=text.align_center)
        table.merge_cells(dash, 2, 9, 3, 9)

        // ── Row 10: P(Sideways) ────────────────────────────────────────────────
        table.cell(dash, 0, 10, _pSideLbl, bgcolor=rowBg, text_color=txtDim,
                   text_size=size.small, text_halign=text.align_left)
        table.merge_cells(dash, 0, 10, 1, 10)
        table.cell(dash, 2, 10, str.tostring(pSideNext, "#.1") + "%",
                   bgcolor=color.new(color.gray, 25), text_color=txtFull,
                   text_size=size.normal, text_halign=text.align_center)
        table.merge_cells(dash, 2, 10, 3, 10)

        // ── Row 11: Second-Order Probability ──────────────────────────────────
        table.cell(dash, 0, 11, _s2Label + (i_useSecondOrder ? "" : "  (off)"),
                   bgcolor=rowBg, text_color=txtDim, text_size=size.small, text_halign=text.align_left)
        table.merge_cells(dash, 0, 11, 1, 11)
        table.cell(dash, 2, 11, str.tostring(_s2Prob, "#.1") + "%",
                   bgcolor=color.new(biasColor, 20), text_color=txtFull,
                   text_size=size.small, text_halign=text.align_center)
        table.merge_cells(dash, 2, 11, 3, 11)

        // ── Row 12: Entropy Confidence ─────────────────────────────────────────
        table.cell(dash, 0, 12, "Entropy Confidence" + (i_useEntropy ? "" : "  (off)"),
                   bgcolor=rowBg, text_color=txtDim, text_size=size.small, text_halign=text.align_left)
        table.merge_cells(dash, 0, 12, 1, 12)
        color entBg = entropyConf > 65.0 ? color.new(#005f73, 10) : color.new(color.gray, 30)
        table.cell(dash, 2, 12, str.tostring(entropyConf, "#.1") + "%",
                   bgcolor=entBg, text_color=txtFull,
                   text_size=size.small, text_halign=text.align_center)
        table.merge_cells(dash, 2, 12, 3, 12)

        // ── Row 13: VIX Regime ─────────────────────────────────────────────────
        string vixStr = not na(vixClose) ? (isHighVol ? "HIGH VOL  VIX " : "LOW VOL   VIX ") + str.tostring(vixClose, "#.1") : "N/A (no VIX data)"
        table.cell(dash, 0, 13, "VIX Regime" + (i_useVix ? "" : "  (off)"),
                   bgcolor=rowBg, text_color=txtDim, text_size=size.small, text_halign=text.align_left)
        table.merge_cells(dash, 0, 13, 1, 13)
        color vixBg = not na(vixClose) ? (isHighVol ? color.new(color.red, 15) : color.new(color.green, 15)) : color.new(color.gray, 30)
        table.cell(dash, 2, 13, vixStr,
                   bgcolor=vixBg, text_color=txtFull,
                   text_size=size.small, text_halign=text.align_center)
        table.merge_cells(dash, 2, 13, 3, 13)

        // ── Row 14: MTF Alignment ──────────────────────────────────────────────
        string mtfStr = "D:" + (biasDirD ==  1 ? "▲" : biasDirD == -1 ? "▼" : "◆") + "   W:" + (biasDirW ==  1 ? "▲" : biasDirW == -1 ? "▼" : "◆") + "   M:" + (biasDirM ==  1 ? "▲" : biasDirM == -1 ? "▼" : "◆")
        table.cell(dash, 0, 14, "MTF Alignment" + (i_useMtf ? "" : "  (off)"),
                   bgcolor=rowBg, text_color=txtDim, text_size=size.small, text_halign=text.align_left)
        table.merge_cells(dash, 0, 14, 1, 14)
        color mtfBg = mtfScore >= 2 ? color.new(#005f73, 10) : color.new(color.gray, 30)
        table.cell(dash, 2, 14, mtfStr + "   " + str.tostring(mtfScore) + "/3",
                   bgcolor=mtfBg, text_color=txtFull,
                   text_size=size.small, text_halign=text.align_center)
        table.merge_cells(dash, 2, 14, 3, 14)

        // ── Row 15: Regime Duration ────────────────────────────────────────────
        table.cell(dash, 0, 15, "Regime Duration" + (i_useDuration ? "" : "  (off)"),
                   bgcolor=rowBg, text_color=txtDim, text_size=size.small, text_halign=text.align_left)
        table.merge_cells(dash, 0, 15, 1, 15)
        color durBg = regimeDuration >= 5 ? color.new(#005f73, 10) : color.new(color.gray, 30)
        table.cell(dash, 2, 15, str.tostring(regimeDuration) + " consecutive bars",
                   bgcolor=durBg, text_color=txtFull,
                   text_size=size.small, text_halign=text.align_center)
        table.merge_cells(dash, 2, 15, 3, 15)

        // ── Row 16: Next Session Bias (shown when Next Session Mode is on) ─────
        if i_nextSessionMode
            table.cell(dash, 0, 16, _nextLbl, bgcolor=rowBg, text_color=txtDim,
                       text_size=size.small, text_halign=text.align_left)
            table.merge_cells(dash, 0, 16, 1, 16)
            table.cell(dash, 2, 16, biasLabel,
                       bgcolor=color.new(biasColor, 10), text_color=biasColor,
                       text_size=size.normal, text_halign=text.align_center)
            table.merge_cells(dash, 2, 16, 3, 16)

        // ── Row 17: Sample Size ────────────────────────────────────────────────
        color  sampleBg  = lowSample ? color.new(color.orange, 10) : color.new(#005f73, 10)
        string sampleStr = str.tostring(int(totalTrans)) + (lowSample ? "  ⚠ LOW" : " transitions")
        table.cell(dash, 0, 17, "Sample Size", bgcolor=rowBg, text_color=txtDim,
                   text_size=size.small, text_halign=text.align_left)
        table.merge_cells(dash, 0, 17, 1, 17)
        table.cell(dash, 2, 17, sampleStr,
                   bgcolor=sampleBg, text_color=txtFull,
                   text_size=size.small, text_halign=text.align_center)
        table.merge_cells(dash, 2, 17, 3, 17)

        // ── Row 18: Threshold footer ───────────────────────────────────────────
        table.cell(dash, 0, 18,
                   "1st-Order threshold: " + str.tostring(i_biasThresh, "#.0") + "%  |  " +
                   "Lookback: " + str.tostring(i_lookback) + _lookbackUnit,
                   bgcolor=color.new(#0d1b2a, 10), text_color=color.new(color.white, 25),
                   text_size=size.tiny, text_halign=text.align_center)
        table.merge_cells(dash, 0, 18, 3, 18)

        // ── Rows 19-23: Transition Matrix Grid (optional) ─────────────────────
        if i_showMatrix
            table.cell(dash, 0, 19, "─── First-Order Transition Matrix ───",
                       bgcolor=color.new(#0d1b2a, 10), text_color=color.new(color.white, 25),
                       text_size=size.tiny, text_halign=text.align_center)
            table.merge_cells(dash, 0, 19, 3, 19)
            table.cell(dash, 0, 20, "FROM \\ TO",
                       bgcolor=color.new(color.gray, 35), text_color=txtFull, text_size=size.tiny)
            table.cell(dash, 1, 20, "→ BULL",
                       bgcolor=color.new(color.green, 30), text_color=txtFull,
                       text_size=size.tiny, text_halign=text.align_center)
            table.cell(dash, 2, 20, "→ BEAR",
                       bgcolor=color.new(color.red,   30), text_color=txtFull,
                       text_size=size.tiny, text_halign=text.align_center)
            table.cell(dash, 3, 20, "→ SIDE",
                       bgcolor=color.new(color.gray,  35), text_color=txtFull,
                       text_size=size.tiny, text_halign=text.align_center)
            float[] allProbs   = array.from(pBull0, pBear0, pSide0,
                                            pBull1, pBear1, pSide1,
                                            pBull2, pBear2, pSide2)
            string[] rowLabels = array.from("BULL →", "BEAR →", "SIDE →")
            for int fromSt = 0 to 2
                int   rowIdx     = 21 + fromSt
                color rowLabelBg = fromSt == 0 ? color.new(color.green, 25) :
                                   fromSt == 1 ? color.new(color.red,   25) :
                                                 color.new(color.gray,  30)
                table.cell(dash, 0, rowIdx, array.get(rowLabels, fromSt),
                           bgcolor=rowLabelBg, text_color=txtFull, text_size=size.tiny)
                for int toSt = 0 to 2
                    float p      = array.get(allProbs, fromSt * 3 + toSt)
                    float rowMax = math.max(array.get(allProbs, fromSt * 3 + 0),
                                   math.max(array.get(allProbs, fromSt * 3 + 1),
                                            array.get(allProbs, fromSt * 3 + 2)))
                    bool  isMax  = p >= rowMax - 0.01
                    int   alpha  = isMax ? 8 : int(math.max(25, math.min(55, 55 - p * 0.4)))
                    color cellBg = toSt == 0 ? color.new(color.green, alpha) :
                                   toSt == 1 ? color.new(color.red,   alpha) :
                                               color.new(color.gray,  alpha)
                    table.cell(dash, toSt + 1, rowIdx,
                               str.tostring(p, "#.0") + "%",
                               bgcolor=cellBg, text_color=txtFull,
                               text_size=size.tiny, text_halign=text.align_center)

    // ── SECTION 14B: SIGNAL PERFORMANCE DASHBOARD ─────────────────────────────
    if i_showStats
        // Text size for all cells — controlled by i_statsTblSize
        string _sSz  = i_statsTblSize == "Tiny" ? size.tiny : i_statsTblSize == "Normal" ? size.normal : i_statsTblSize == "Large" ? size.large : size.small

        color hdrBg    = color.new(#0d1b2a, 5)
        color txtFull  = color.white
        color _sBg     = color.new(#0a1a2e, 10)
        color _sHdrBg  = color.new(#1a3a5c, 5)
        color _sOffBg  = color.new(color.gray, 45)
        color _sOffTxt = color.new(color.white, 25)

        // ── Row 0: Title ──────────────────────────────────────────────────────
        string _gapSuffix        = i_gapMode       ? "  [gap]"           : ""
        string _macdSuffix       = i_useMacdFilter ? "  [MACD filtered]" : ""
        string _statsTitleSuffix = _gapSuffix + _macdSuffix
        table.cell(statsDash, 0, 0, "SIGNAL PERFORMANCE  [MRB v3.4]" + _statsTitleSuffix,
                   bgcolor=hdrBg, text_color=txtFull,
                   text_size=_sSz, text_halign=text.align_center)
        table.merge_cells(statsDash, 0, 0, 3, 0)

        // ── All History (rows 1-7) ─────────────────────────────────────────────
        table.cell(statsDash, 0, 1, i_statsAllHist ? "ALL HISTORY" : "ALL HISTORY  (off)",
                   bgcolor=i_statsAllHist ? _sHdrBg : _sOffBg,
                   text_color=i_statsAllHist ? color.new(color.white, 15) : _sOffTxt,
                   text_size=_sSz, text_halign=text.align_center)
        table.merge_cells(statsDash, 0, 1, 3, 1)

        if i_statsAllHist
            int ahTotW = ahBullW + ahBearW
            int ahTotL = ahBullL + ahBearL
            string ahStreakStr = ahStreak == 0 ? "--" : str.tostring(ahStreak) + (ahLastRes == 1 ? "W" : "L") + " str"
            table.cell(statsDash, 0, 2, "Bullish",             bgcolor=color.new(i_colorBull, 25), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 1, 2, f_wl(ahBullW,ahBullL), bgcolor=_sBg, text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.merge_cells(statsDash, 1, 2, 2, 2)
            table.cell(statsDash, 3, 2, f_wr(ahBullW,ahBullL), bgcolor=color.new(i_colorBull, 25), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 0, 3, "Bearish",             bgcolor=color.new(i_colorBear, 25), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 1, 3, f_wl(ahBearW,ahBearL), bgcolor=_sBg, text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.merge_cells(statsDash, 1, 3, 2, 3)
            table.cell(statsDash, 3, 3, f_wr(ahBearW,ahBearL), bgcolor=color.new(i_colorBear, 25), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 0, 4, "Overall",             bgcolor=color.new(color.gray, 30), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 1, 4, f_wl(ahTotW,ahTotL),  bgcolor=_sBg, text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 2, 4, f_wr(ahTotW,ahTotL),  bgcolor=_sBg, text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 3, 4, ahStreakStr,            bgcolor=color.new(ahLastRes == 1 ? color.green : color.red, 25), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            float ahWinAmt  = ahBullWAmt + ahBearWAmt
            float ahLossAmt = ahBullLAmt + ahBearLAmt
            float ahNetAmt  = ahWinAmt + ahLossAmt
            color ahNetBg   = ahNetAmt >= 0.0 ? color.new(color.green, 25) : color.new(color.red, 25)
            table.cell(statsDash, 0, 5, "Price Move",           bgcolor=color.new(color.gray, 40), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 1, 5, f_fmtAmt(ahWinAmt),    bgcolor=color.new(color.green, 30), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 2, 5, f_fmtAmt(ahLossAmt),   bgcolor=color.new(color.red,   30), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 3, 5, f_fmtAmt(ahNetAmt),    bgcolor=ahNetBg, text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 0, 6, "Avg Move",             bgcolor=color.new(color.gray, 40), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 1, 6, f_fmtAvg(ahWinAmt,  ahTotW), bgcolor=color.new(color.green, 30), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 2, 6, f_fmtAvg(ahLossAmt, ahTotL), bgcolor=color.new(color.red,   30), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 3, 6, "",                     bgcolor=color.new(color.gray, 40), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 0, 7, "Avg Net",              bgcolor=color.new(color.gray, 40), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 1, 7, f_fmtAvg(ahNetAmt, ahTotW + ahTotL), bgcolor=ahNetBg, text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.merge_cells(statsDash, 1, 7, 3, 7)
        else
            table.cell(statsDash, 0, 2, "", bgcolor=_sOffBg, text_color=txtFull, text_size=_sSz)
            table.merge_cells(statsDash, 0, 2, 3, 2)
            table.cell(statsDash, 0, 3, "", bgcolor=_sOffBg, text_color=txtFull, text_size=_sSz)
            table.merge_cells(statsDash, 0, 3, 3, 3)
            table.cell(statsDash, 0, 4, "", bgcolor=_sOffBg, text_color=txtFull, text_size=_sSz)
            table.merge_cells(statsDash, 0, 4, 3, 4)
            table.cell(statsDash, 0, 5, "", bgcolor=_sOffBg, text_color=txtFull, text_size=_sSz)
            table.merge_cells(statsDash, 0, 5, 3, 5)
            table.cell(statsDash, 0, 6, "", bgcolor=_sOffBg, text_color=txtFull, text_size=_sSz)
            table.merge_cells(statsDash, 0, 6, 3, 6)
            table.cell(statsDash, 0, 7, "", bgcolor=_sOffBg, text_color=txtFull, text_size=_sSz)
            table.merge_cells(statsDash, 0, 7, 3, 7)

        // ── Last N Signals (rows 8-14) ─────────────────────────────────────────
        string _lnHdr = "LAST " + str.tostring(i_lastNCount) + " SIGNALS" + (i_statsLastN ? "  (" + str.tostring(lnSz) + " logged)" : "  (off)")
        table.cell(statsDash, 0, 8, _lnHdr,
                   bgcolor=i_statsLastN ? _sHdrBg : _sOffBg,
                   text_color=i_statsLastN ? color.new(color.white, 15) : _sOffTxt,
                   text_size=_sSz, text_halign=text.align_center)
        table.merge_cells(statsDash, 0, 8, 3, 8)

        if i_statsLastN
            int lnTotW = lnBullW + lnBearW
            int lnTotL = lnBullL + lnBearL
            table.cell(statsDash, 0, 9,  "Bullish",             bgcolor=color.new(i_colorBull, 25), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 1, 9,  f_wl(lnBullW,lnBullL), bgcolor=_sBg, text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.merge_cells(statsDash, 1, 9, 2, 9)
            table.cell(statsDash, 3, 9,  f_wr(lnBullW,lnBullL), bgcolor=color.new(i_colorBull, 25), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 0, 10, "Bearish",             bgcolor=color.new(i_colorBear, 25), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 1, 10, f_wl(lnBearW,lnBearL), bgcolor=_sBg, text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.merge_cells(statsDash, 1, 10, 2, 10)
            table.cell(statsDash, 3, 10, f_wr(lnBearW,lnBearL), bgcolor=color.new(i_colorBear, 25), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 0, 11, "Overall",             bgcolor=color.new(color.gray, 30), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 1, 11, f_wl(lnTotW,lnTotL),  bgcolor=_sBg, text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 2, 11, f_wr(lnTotW,lnTotL),  bgcolor=_sBg, text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 3, 11, str.tostring(lnSz) + " / " + str.tostring(i_lastNCount), bgcolor=color.new(color.gray, 30), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            float lnNetAmt = lnWinAmt + lnLossAmt
            color lnNetBg  = lnNetAmt >= 0.0 ? color.new(color.green, 25) : color.new(color.red, 25)
            table.cell(statsDash, 0, 12, "Price Move",          bgcolor=color.new(color.gray, 40), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 1, 12, f_fmtAmt(lnWinAmt),   bgcolor=color.new(color.green, 30), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 2, 12, f_fmtAmt(lnLossAmt),  bgcolor=color.new(color.red,   30), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 3, 12, f_fmtAmt(lnNetAmt),   bgcolor=lnNetBg, text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 0, 13, "Avg Move",            bgcolor=color.new(color.gray, 40), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 1, 13, f_fmtAvg(lnWinAmt,  lnTotW), bgcolor=color.new(color.green, 30), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 2, 13, f_fmtAvg(lnLossAmt, lnTotL), bgcolor=color.new(color.red,   30), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 3, 13, "",                    bgcolor=color.new(color.gray, 40), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 0, 14, "Avg Net",             bgcolor=color.new(color.gray, 40), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 1, 14, f_fmtAvg(lnNetAmt, lnTotW + lnTotL), bgcolor=lnNetBg, text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.merge_cells(statsDash, 1, 14, 3, 14)
        else
            table.cell(statsDash, 0, 9,  "", bgcolor=_sOffBg, text_color=txtFull, text_size=_sSz)
            table.merge_cells(statsDash, 0, 9, 3, 9)
            table.cell(statsDash, 0, 10, "", bgcolor=_sOffBg, text_color=txtFull, text_size=_sSz)
            table.merge_cells(statsDash, 0, 10, 3, 10)
            table.cell(statsDash, 0, 11, "", bgcolor=_sOffBg, text_color=txtFull, text_size=_sSz)
            table.merge_cells(statsDash, 0, 11, 3, 11)
            table.cell(statsDash, 0, 12, "", bgcolor=_sOffBg, text_color=txtFull, text_size=_sSz)
            table.merge_cells(statsDash, 0, 12, 3, 12)
            table.cell(statsDash, 0, 13, "", bgcolor=_sOffBg, text_color=txtFull, text_size=_sSz)
            table.merge_cells(statsDash, 0, 13, 3, 13)
            table.cell(statsDash, 0, 14, "", bgcolor=_sOffBg, text_color=txtFull, text_size=_sSz)
            table.merge_cells(statsDash, 0, 14, 3, 14)

        // ── Date Range (rows 15-21) ────────────────────────────────────────────
        string _drHdr = "DATE RANGE" + (i_statsDateRange ? ":  " + str.format_time(i_drStart, "MMM yyyy", "UTC") + " – " + str.format_time(i_drEnd, "MMM yyyy", "UTC") : "  (off)")
        table.cell(statsDash, 0, 15, _drHdr,
                   bgcolor=i_statsDateRange ? _sHdrBg : _sOffBg,
                   text_color=i_statsDateRange ? color.new(color.white, 15) : _sOffTxt,
                   text_size=_sSz, text_halign=text.align_center)
        table.merge_cells(statsDash, 0, 15, 3, 15)

        if i_statsDateRange
            int drTotW = drBullW + drBearW
            int drTotL = drBullL + drBearL
            table.cell(statsDash, 0, 16, "Bullish",             bgcolor=color.new(i_colorBull, 25), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 1, 16, f_wl(drBullW,drBullL), bgcolor=_sBg, text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.merge_cells(statsDash, 1, 16, 2, 16)
            table.cell(statsDash, 3, 16, f_wr(drBullW,drBullL), bgcolor=color.new(i_colorBull, 25), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 0, 17, "Bearish",             bgcolor=color.new(i_colorBear, 25), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 1, 17, f_wl(drBearW,drBearL), bgcolor=_sBg, text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.merge_cells(statsDash, 1, 17, 2, 17)
            table.cell(statsDash, 3, 17, f_wr(drBearW,drBearL), bgcolor=color.new(i_colorBear, 25), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 0, 18, "Overall",             bgcolor=color.new(color.gray, 30), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 1, 18, f_wl(drTotW,drTotL),  bgcolor=_sBg, text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 2, 18, f_wr(drTotW,drTotL),  bgcolor=_sBg, text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 3, 18, str.tostring(drTotW + drTotL) + " signals", bgcolor=color.new(color.gray, 30), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            float drWinAmt  = drBullWAmt + drBearWAmt
            float drLossAmt = drBullLAmt + drBearLAmt
            float drNetAmt  = drWinAmt + drLossAmt
            color drNetBg   = drNetAmt >= 0.0 ? color.new(color.green, 25) : color.new(color.red, 25)
            table.cell(statsDash, 0, 19, "Price Move",          bgcolor=color.new(color.gray, 40), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 1, 19, f_fmtAmt(drWinAmt),   bgcolor=color.new(color.green, 30), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 2, 19, f_fmtAmt(drLossAmt),  bgcolor=color.new(color.red,   30), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 3, 19, f_fmtAmt(drNetAmt),   bgcolor=drNetBg, text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 0, 20, "Avg Move",            bgcolor=color.new(color.gray, 40), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 1, 20, f_fmtAvg(drWinAmt,  drTotW), bgcolor=color.new(color.green, 30), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 2, 20, f_fmtAvg(drLossAmt, drTotL), bgcolor=color.new(color.red,   30), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 3, 20, "",                    bgcolor=color.new(color.gray, 40), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 0, 21, "Avg Net",             bgcolor=color.new(color.gray, 40), text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.cell(statsDash, 1, 21, f_fmtAvg(drNetAmt, drTotW + drTotL), bgcolor=drNetBg, text_color=txtFull, text_size=_sSz, text_halign=text.align_center)
            table.merge_cells(statsDash, 1, 21, 3, 21)
        else
            table.cell(statsDash, 0, 16, "", bgcolor=_sOffBg, text_color=txtFull, text_size=_sSz)
            table.merge_cells(statsDash, 0, 16, 3, 16)
            table.cell(statsDash, 0, 17, "", bgcolor=_sOffBg, text_color=txtFull, text_size=_sSz)
            table.merge_cells(statsDash, 0, 17, 3, 17)
            table.cell(statsDash, 0, 18, "", bgcolor=_sOffBg, text_color=txtFull, text_size=_sSz)
            table.merge_cells(statsDash, 0, 18, 3, 18)
            table.cell(statsDash, 0, 19, "", bgcolor=_sOffBg, text_color=txtFull, text_size=_sSz)
            table.merge_cells(statsDash, 0, 19, 3, 19)
            table.cell(statsDash, 0, 20, "", bgcolor=_sOffBg, text_color=txtFull, text_size=_sSz)
            table.merge_cells(statsDash, 0, 20, 3, 20)
            table.cell(statsDash, 0, 21, "", bgcolor=_sOffBg, text_color=txtFull, text_size=_sSz)
            table.merge_cells(statsDash, 0, 21, 3, 21)

    // ── SECTION 14C: EVALUATION DASHBOARD ─────────────────────────────────────
    // Layout (4×12):
    //   R0: title  |  R1: CURRENT SESSION header  |  R2-5: bias/signal/composite/confluence
    //   R6: NEXT SESSION header  |  R7: start date
    //   R8: date range header  |  R9-11: perf stats
    if i_showEval
        string _sSzV   = i_evalTblSize == "Tiny" ? size.tiny : i_evalTblSize == "Normal" ? size.normal : i_evalTblSize == "Large" ? size.large : size.small
        color hdrBgV   = color.new(#0d1b2a, 0)
        color rowBgV   = color.new(#0d1b2a, 20)
        color lblTxtV  = color.new(color.white, 20)
        color txtFullV = color.white
        color _sBgV    = color.new(#1a3a5c, 0)
        color _evOffBg = color.new(color.gray, 45)

        // ── Row 0: Title ──────────────────────────────────────────────────────
        string _evSfx = (i_gapMode ? "  [gap]" : "") + (i_useMacdFilter ? "  [MACD]" : "")
        table.cell(evalDash, 0, 0, "EVALUATION  [MRB v3.4]" + _evSfx,
                   bgcolor=hdrBgV, text_color=txtFullV, text_size=_sSzV, text_halign=text.align_center)
        table.merge_cells(evalDash, 0, 0, 3, 0)

        // ── Current session period label for section header ────────────────────
        string _curSessHdr = i_resolution == "Daily" ? str.format_time(time, "MMM d, yyyy", "UTC") : i_resolution == "Weekly" ? str.format_time(time, "MMM d", "UTC") + " – " + str.format_time(time_close, "MMM d", "UTC") : str.format_time(time, "MMM yyyy", "UTC")

        // ── Row 1: Current Session section header ──────────────────────────────
        table.cell(evalDash, 0, 1, "CURRENT SESSION  " + _curSessHdr,
                   bgcolor=hdrBgV, text_color=color.new(color.white, 25), text_size=_sSzV, text_halign=text.align_center)
        table.merge_cells(evalDash, 0, 1, 3, 1)

        // ── Row 2: Bias Direction ──────────────────────────────────────────────
        color biasBgV = biasDir == 1 ? color.new(i_colorBull, 0) : biasDir == -1 ? color.new(i_colorBear, 0) : color.new(i_colorSide, 10)
        table.cell(evalDash, 0, 2, "Bias",
                   bgcolor=rowBgV, text_color=lblTxtV, text_size=_sSzV, text_halign=text.align_left)
        table.cell(evalDash, 1, 2, biasLabel,
                   bgcolor=biasBgV, text_color=color.white, text_size=_sSzV, text_halign=text.align_center)
        table.merge_cells(evalDash, 1, 2, 3, 2)

        // ── Row 3: Signal Quality ──────────────────────────────────────────────
        string _evalSigLabel = isSignalHigh ? "HIGH" : isSignalMedium and isSignalHighRaw and not notExhausted ? "MEDIUM  (ext)" : isSignalMedium and isSignalHighRaw and not macdAligned ? "MEDIUM  (MACD)" : isSignalMedium ? "MEDIUM" : "LOW"
        color sqBgV  = isSignalHigh ? color.new(i_colorBull, 0) : isSignalMedium ? color.new(color.orange, 0) : color.new(color.gray, 15)
        table.cell(evalDash, 0, 3, "Signal",
                   bgcolor=rowBgV, text_color=lblTxtV, text_size=_sSzV, text_halign=text.align_left)
        table.cell(evalDash, 1, 3, _evalSigLabel,
                   bgcolor=sqBgV, text_color=color.white, text_size=_sSzV, text_halign=text.align_center)
        table.merge_cells(evalDash, 1, 3, 3, 3)

        // ── Row 4: Composite Probability ──────────────────────────────────────
        color compBgV = compositeProb >= i_compThreshH ? color.new(#005f73, 0) : compositeProb >= i_compThreshM ? color.new(color.orange, 0) : color.new(color.gray, 15)
        table.cell(evalDash, 0, 4, "Composite",
                   bgcolor=rowBgV, text_color=lblTxtV, text_size=_sSzV, text_halign=text.align_left)
        table.cell(evalDash, 1, 4, str.tostring(compositeProb, "#.1") + "%",
                   bgcolor=compBgV, text_color=txtFullV, text_size=_sSzV, text_halign=text.align_center)
        table.merge_cells(evalDash, 1, 4, 3, 4)

        // ── Row 5: Confluence Score ────────────────────────────────────────────
        color confBgV = confScore >= i_confThreshH ? color.new(#005f73, 0) : confScore >= i_confThreshM ? color.new(color.orange, 0) : color.new(color.gray, 15)
        table.cell(evalDash, 0, 5, "Confluence",
                   bgcolor=rowBgV, text_color=lblTxtV, text_size=_sSzV, text_halign=text.align_left)
        table.cell(evalDash, 1, 5, str.tostring(confScore) + " / 5",
                   bgcolor=confBgV, text_color=txtFullV, text_size=_sSzV, text_halign=text.align_center)
        table.merge_cells(evalDash, 1, 5, 3, 5)

        // ── Row 6: Next Session section header ────────────────────────────────
        table.cell(evalDash, 0, 6, "NEXT SESSION",
                   bgcolor=hdrBgV, text_color=color.new(color.white, 25), text_size=_sSzV, text_halign=text.align_center)
        table.merge_cells(evalDash, 0, 6, 3, 6)

        // ── Row 7: Next session start date ────────────────────────────────────
        // Weekly: Friday close + 3 days = Monday open of next week
        // Daily/Monthly: close + 1 day (approximate)
        int _msDay = 86400000
        int _nextTs = i_resolution == "Weekly" ? time_close + 3 * _msDay : time_close + _msDay
        string _nextDate = str.format_time(_nextTs, "MMM d, yyyy", "UTC")
        table.cell(evalDash, 0, 7, "Starts",
                   bgcolor=rowBgV, text_color=lblTxtV, text_size=_sSzV, text_halign=text.align_left)
        table.cell(evalDash, 1, 7, _nextDate,
                   bgcolor=_sBgV, text_color=txtFullV, text_size=_sSzV, text_halign=text.align_center)
        table.merge_cells(evalDash, 1, 7, 3, 7)

        // ── Row 8: Date Range header ───────────────────────────────────────────
        string _drHdrV = i_statsDateRange ? str.format_time(i_drStart, "MMM yyyy", "UTC") + " – " + str.format_time(i_drEnd, "MMM yyyy", "UTC") : "DATE RANGE  (off)"
        color  _drBgV  = i_statsDateRange ? color.new(#1a3a5c, 5) : _evOffBg
        table.cell(evalDash, 0, 8, _drHdrV,
                   bgcolor=_drBgV, text_color=color.new(color.white, 15), text_size=_sSzV, text_halign=text.align_center)
        table.merge_cells(evalDash, 0, 8, 3, 8)

        // ── Rows 9-11: Date Range performance ─────────────────────────────────
        int   evDrTotW = drBullW  + drBearW
        int   evDrTotL = drBullL  + drBearL
        int   evDrTot  = evDrTotW + evDrTotL
        float evDrWin  = drBullWAmt + drBearWAmt
        float evDrLos  = drBullLAmt + drBearLAmt
        float evDrNet  = evDrWin + evDrLos
        color evNetBgV = evDrNet >= 0.0 ? color.new(color.green, 0) : color.new(color.red, 0)

        if i_statsDateRange
            // Row 9: Overall W/L | win% | signal count
            table.cell(evalDash, 0, 9,  "Overall",              bgcolor=color.new(color.gray, 0), text_color=txtFullV, text_size=_sSzV, text_halign=text.align_center)
            table.cell(evalDash, 1, 9,  f_wl(evDrTotW, evDrTotL), bgcolor=_sBgV,                 text_color=txtFullV, text_size=_sSzV, text_halign=text.align_center)
            table.cell(evalDash, 2, 9,  f_wr(evDrTotW, evDrTotL), bgcolor=_sBgV,                 text_color=txtFullV, text_size=_sSzV, text_halign=text.align_center)
            table.cell(evalDash, 3, 9,  str.tostring(evDrTot) + " sig", bgcolor=color.new(color.gray, 0), text_color=txtFullV, text_size=_sSzV, text_halign=text.align_center)
            // Row 10: Price Move — win | loss | net
            table.cell(evalDash, 0, 10, "Price Move",           bgcolor=color.new(color.gray, 0), text_color=txtFullV, text_size=_sSzV, text_halign=text.align_center)
            table.cell(evalDash, 1, 10, f_fmtAmt(evDrWin),     bgcolor=color.new(color.green, 0), text_color=txtFullV, text_size=_sSzV, text_halign=text.align_center)
            table.cell(evalDash, 2, 10, f_fmtAmt(evDrLos),     bgcolor=color.new(color.red,   0), text_color=txtFullV, text_size=_sSzV, text_halign=text.align_center)
            table.cell(evalDash, 3, 10, f_fmtAmt(evDrNet),     bgcolor=evNetBgV,                  text_color=txtFullV, text_size=_sSzV, text_halign=text.align_center)
            // Row 11: Avg Move — avg win | avg loss | avg net
            table.cell(evalDash, 0, 11, "Avg Move",             bgcolor=color.new(color.gray, 0), text_color=txtFullV, text_size=_sSzV, text_halign=text.align_center)
            table.cell(evalDash, 1, 11, f_fmtAvg(evDrWin, evDrTotW), bgcolor=color.new(color.green, 0), text_color=txtFullV, text_size=_sSzV, text_halign=text.align_center)
            table.cell(evalDash, 2, 11, f_fmtAvg(evDrLos, evDrTotL), bgcolor=color.new(color.red,   0), text_color=txtFullV, text_size=_sSzV, text_halign=text.align_center)
            table.cell(evalDash, 3, 11, f_fmtAvg(evDrNet, evDrTot),  bgcolor=evNetBgV,                  text_color=txtFullV, text_size=_sSzV, text_halign=text.align_center)
        else
            for r = 9 to 11
                table.cell(evalDash, 0, r, "", bgcolor=_evOffBg, text_color=txtFullV, text_size=_sSzV)
                table.merge_cells(evalDash, 0, r, 3, r)

// ============================================================================
// SECTION 15 — ALERTS
// ============================================================================

var int prevBiasDir = na
bool flipBullish = not na(prevBiasDir) and prevBiasDir != 1  and biasDir == 1
bool flipBearish = not na(prevBiasDir) and prevBiasDir != -1 and biasDir == -1
bool flipNeutral = not na(prevBiasDir) and prevBiasDir != 0  and biasDir == 0

if isResUpdate
    prevBiasDir := biasDir

alertcondition(flipBullish and isSignalHigh, title="MRB — HIGH: Bias flipped BULLISH",
    message="[MRB Institutional] {{ticker}} bias flipped BULLISH — HIGH quality. Check composite + confluence on dashboard.")
alertcondition(flipBearish and isSignalHigh, title="MRB — HIGH: Bias flipped BEARISH",
    message="[MRB Institutional] {{ticker}} bias flipped BEARISH — HIGH quality. Check composite + confluence on dashboard.")
alertcondition(flipBullish and isSignalMedium, title="MRB — MEDIUM: Bias flipped BULLISH",
    message="[MRB Institutional] {{ticker}} bias flipped BULLISH — MEDIUM quality. Model is not in HIGH gate; proceed with extra discretion.")
alertcondition(flipBearish and isSignalMedium, title="MRB — MEDIUM: Bias flipped BEARISH",
    message="[MRB Institutional] {{ticker}} bias flipped BEARISH — MEDIUM quality. Model is not in HIGH gate; proceed with extra discretion.")
alertcondition(flipNeutral, title="MRB — Bias flipped NEUTRAL",
    message="[MRB Institutional] {{ticker}} bias flipped NEUTRAL — no directional edge. Sit out.")
alertcondition(lowSample, title="MRB — Low Sample Size Warning",
    message="[MRB Institutional] {{ticker}} transition matrix has insufficient sample size. Treat probabilities with caution.")
